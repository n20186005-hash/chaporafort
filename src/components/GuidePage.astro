---
// एका मार्गदर्शक पानाचो सामायिक साचो (breadcrumbs, मजकूर, FAQ, संबंदीत दुवे).
// 42 पानां खातीर एकूच आराखडो वापरतात आनी भासेनुसार मजकूर निवडतात.
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSiteName, SITE_ORIGIN, LAST_VERIFIED_LABEL } from '../data/site';
import { type Locale, localeBase } from '../i18n/utils';
import { type Guide, getGuide, categoryLabel } from '../data/guides';

interface Props {
  guide: Guide;
  locale: Locale;
}
const { guide, locale } = Astro.props;
const copy = locale === 'en' ? guide.en : guide.kok;
const base = localeBase(locale);
const cat = categoryLabel(guide.category, locale);

const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : undefined);
const pageUrl = abs(Astro.url.pathname) ?? '';
const hubUrl = abs(`${base}/guides/`);

const homeName = locale === 'en' ? 'Home' : 'मुखेल पान';
const hubName = locale === 'en' ? 'Guides' : 'मार्गदर्शक';

const crumbs: { name: string; url?: string }[] = [
  { name: homeName, url: abs(`${base}/`) },
  { name: hubName, url: hubUrl },
  { name: cat },
  { name: copy.h1, url: pageUrl }
];

const related = guide.related
  .map((slug) => getGuide(slug))
  .filter((g): g is Guide => Boolean(g))
  .map((g) => {
    const c = locale === 'en' ? g.en : g.kok;
    return { slug: g.slug, title: c.title, h1: c.h1, description: c.description, category: categoryLabel(g.category, locale) };
  });

// भोंवडी-मार्ग दुवे (itinerary cross-links) — दर पानाक धड संबंदीत पर्याय.
const relatedSlugs = new Set(guide.related);
const itineraryLinks = guide.category === 'itinerary'
  ? []
  : ['90-minute-itinerary', 'fort-vagator-half-day', 'north-goa-forts-day-trip']
      .filter((slug) => !relatedSlugs.has(slug))
      .map((slug) => getGuide(slug))
      .filter((g): g is Guide => Boolean(g))
      .map((g) => {
        const c = locale === 'en' ? g.en : g.kok;
        return { slug: g.slug, h1: c.h1, description: c.description };
      });

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': pageUrl ? `${pageUrl}#breadcrumb` : '#breadcrumb',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    ...(c.url ? { item: c.url } : {})
  }))
};

const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageUrl ? `${pageUrl}#webpage` : '#webpage',
  ...(pageUrl ? { url: pageUrl } : {}),
  name: copy.title,
  description: copy.description,
  inLanguage: locale === 'en' ? 'en' : 'kok-Deva',
  ...(hubUrl ? { isPartOf: { '@id': `${SITE_ORIGIN}/#website` } } : {}),
  about: { '@id': `${SITE_ORIGIN}/#chapora-fort` },
  breadcrumb: { '@id': pageUrl ? `${pageUrl}#breadcrumb` : '#breadcrumb' }
};

const faqSchema = copy.faqs && copy.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: copy.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      }))
    }
  : null;

const jsonLd = [webpageSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];

const labels = locale === 'en'
  ? {
      related: 'Related guides',
      itineraries: 'Itineraries to plan around this',
      back: 'Back to the main guide',
      map: 'Open in Google Maps',
      verified: `Last verified: ${LAST_VERIFIED_LABEL.en}`
    }
  : {
      related: 'संबंदीत मार्गदर्शक',
      itineraries: 'हाचेभोंवतणी भोंवडी-मार्ग',
      back: 'मुखेल मार्गदर्शकाक परत वचात',
      map: 'गुगल नकाशांत उगडात',
      verified: `निमाणें तपासलें: ${LAST_VERIFIED_LABEL.kok}`
    };
---
<BaseLayout title={withSiteName(copy.title, locale)} description={copy.description} locale={locale} jsonLd={jsonLd}>
  <article class="bg-sand-50">
    <header class="fort-grid bg-laterite-100 py-12 lg:py-16">
      <div class="mx-auto max-w-3xl px-5 lg:px-8">
        <nav aria-label="breadcrumb" class="text-xs font-bold text-laterite-900/60">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <li><a class="hover:text-laterite-500" href={`${base}/`}>{homeName}</a></li>
            <li aria-hidden="true">›</li>
            <li><a class="hover:text-laterite-500" href={`${base}/guides/`}>{hubName}</a></li>
            <li aria-hidden="true">›</li>
            <li class="text-laterite-900/80">{cat}</li>
          </ol>
        </nav>
        <p class="mt-6 text-sm font-black uppercase tracking-[.18em] text-laterite-500">{cat}</p>
        <h1 class="mt-3 text-4xl font-black leading-tight tracking-tight text-laterite-900 sm:text-5xl">{copy.h1}</h1>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-5 py-12 lg:px-8 lg:py-16">
      <div class="space-y-5 text-lg leading-9 text-laterite-900/85">
        {copy.intro.map((p) => <p>{p}</p>)}
      </div>

      <div class="mt-12 space-y-10">
        {copy.sections.map((s) => (
          <section>
            <h2 class="text-2xl font-black tracking-tight text-laterite-900 sm:text-3xl">{s.heading}</h2>
            <div class="mt-4 space-y-4 leading-8 text-laterite-900/80">
              {s.paragraphs.map((p) => <p>{p}</p>)}
            </div>
            {s.bullets && s.bullets.length > 0 && (
              <ul class="mt-5 space-y-2 rounded-2xl border border-laterite-900/10 bg-white p-5 text-base leading-8 text-laterite-900/80">
                {s.bullets.map((b) => <li class="flex gap-3"><span class="text-laterite-500">•</span><span>{b}</span></li>)}
              </ul>
            )}
          </section>
        ))}
      </div>

      {copy.faqs && copy.faqs.length > 0 && (
        <section class="mt-14">
          <h2 class="text-2xl font-black tracking-tight text-laterite-900 sm:text-3xl">{locale === 'en' ? 'Frequently asked questions' : 'वारंवार विचारले जाणारे प्रश्न'}</h2>
          <div class="mt-6 divide-y divide-laterite-900/10 border-y border-laterite-900/10">
            {copy.faqs.map((f) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-5 text-lg font-black text-laterite-900">
                  <span>{f.q}</span>
                  <span class="text-2xl text-laterite-500 transition group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 pr-10 leading-8 text-laterite-900/70">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <aside class="mt-12 rounded-2xl border border-laterite-900/10 bg-white/70 p-5 text-sm leading-7 text-laterite-900/65">
        <p class="font-bold text-laterite-900">{locale === 'en' ? 'Please note' : 'कृपया नोंद घेवात'}</p>
        <p class="mt-2">{copy.verifyNote}</p>
        <p class="mt-2 font-bold text-laterite-900/75">{labels.verified}</p>
      </aside>

      {related.length > 0 && (
        <section class="mt-14">
          <h2 class="text-xl font-black tracking-tight text-laterite-900">{labels.related}</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {related.map((r) => (
              <a href={`${base}/${r.slug}/`} class="flex flex-col rounded-2xl border border-laterite-900/10 bg-white p-5 no-underline shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <span class="text-xs font-black uppercase tracking-[.14em] text-laterite-500">{r.category}</span>
                <span class="mt-2 font-black text-laterite-900">{r.h1}</span>
                <span class="mt-2 text-sm leading-7 text-laterite-900/65">{r.description}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {itineraryLinks.length > 0 && (
        <section class="mt-14">
          <h2 class="text-xl font-black tracking-tight text-laterite-900">{labels.itineraries}</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-3">
            {itineraryLinks.map((r) => (
              <a href={`${base}/${r.slug}/`} class="flex flex-col rounded-2xl border border-laterite-900/10 bg-white p-5 no-underline shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <span class="font-black text-laterite-900">{r.h1}</span>
                <span class="mt-2 text-sm leading-7 text-laterite-900/65">{r.description}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="mt-12 flex flex-wrap gap-3">
        <a href={`${base}/`} class="rounded-full bg-sea-900 px-5 py-3 font-extrabold text-white no-underline">{labels.back}</a>
        <a href="https://maps.app.goo.gl/3z6axsvdHe2spoFg8" target="_blank" rel="noopener noreferrer" class="rounded-full border border-laterite-900/15 px-5 py-3 font-extrabold text-laterite-700 no-underline hover:bg-laterite-900 hover:text-white">{labels.map}</a>
      </div>
    </div>
  </article>
</BaseLayout>
