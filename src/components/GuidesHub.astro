---
// मार्गदर्शक सूची पान (hub) — श्रेणीनुसार सगळीं 42 पानां एकठांय.
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSiteName, SITE_ORIGIN } from '../data/site';
import { type Locale, localeBase } from '../i18n/utils';
import { guides, GUIDE_CATEGORIES, guidesByCategory } from '../data/guides';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const base = localeBase(locale);

const L = locale === 'en'
  ? {
      eyebrow: 'Guide library',
      title: 'Chapora Fort Guides',
      intro: 'Independent, non-commercial guides to visiting Chapora Fort in Vagator, North Goa — the fort’s history, how to plan a visit, the places and beaches nearby, food, and ready-made itineraries. Choose a topic below.',
      count: (n: number) => `${n} guides`,
      desc: 'Browse every Chapora Fort guide: history, visit planning, the trail and climb, transport, parking, nearby beaches and markets, food and itineraries for north Goa.'
    }
  : {
      eyebrow: 'मार्गदर्शक संग्रह',
      title: 'चापोरा किल्ला मार्गदर्शक',
      intro: 'वागातोर, उत्तर गोवा हांगा चापोरा किल्ल्याक भेट दिवपाक स्वतंत्र, नाफायद्याचे मार्गदर्शक — किल्ल्याचो इतिहास, भेट नियोजन, भोंवतणचीं थळां आनी देगां, जेवण आनी तयार भोंवडी-मार्ग. सकयल खंयचोय विषय निवडात.',
      count: (n: number) => `${n} मार्गदर्शक`,
      desc: 'चापोरा किल्ल्याचे सगळे मार्गदर्शक पळयात: इतिहास, भेट नियोजन, वाट आनी चडप, प्रवास, पार्किंग, भोंवतणच्यो देगां आनी बाजार, जेवण आनी उत्तर गोव्याचे भोंवडी-मार्ग.'
    };

const hubUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : '';
const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': hubUrl ? `${hubUrl}#webpage` : '#webpage',
  ...(hubUrl ? { url: hubUrl } : {}),
  name: L.title,
  description: L.desc,
  inLanguage: locale === 'en' ? 'en' : 'kok-Deva',
  isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
  about: { '@id': `${SITE_ORIGIN}/#chapora-fort` }
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: locale === 'en' ? 'Home' : 'मुखेल पान', item: new URL(`${base}/`, SITE_ORIGIN).href },
    { '@type': 'ListItem', position: 2, name: L.title, ...(hubUrl ? { item: hubUrl } : {}) }
  ]
};
---
<BaseLayout title={withSiteName(L.title, locale)} description={L.desc} locale={locale} jsonLd={[webpageSchema, breadcrumbSchema]}>
  <section class="fort-grid bg-laterite-100 py-14 lg:py-20">
    <div class="mx-auto max-w-4xl px-5 lg:px-8">
      <p class="text-sm font-black uppercase tracking-[.18em] text-laterite-500">{L.eyebrow}</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-laterite-900 sm:text-5xl">{L.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-laterite-900/70">{L.intro}</p>
      <p class="mt-4 text-sm font-bold text-laterite-900/55">{L.count(guides.length)}</p>
    </div>
  </section>

  <div class="bg-sand-50 py-14 lg:py-20">
    <div class="mx-auto max-w-6xl space-y-14 px-5 lg:px-8">
      {GUIDE_CATEGORIES.map((category) => {
        const items = guidesByCategory(category.id);
        if (items.length === 0) return null;
        return (
          <section id={category.id} class="scroll-mt-24">
            <h2 class="text-2xl font-black tracking-tight text-laterite-900 sm:text-3xl">{locale === 'en' ? category.en : category.kok}</h2>
            <div class="mt-6 grid gap-4 md:grid-cols-2">
              {items.map((g) => {
                const c = locale === 'en' ? g.en : g.kok;
                return (
                  <a href={`${base}/${g.slug}/`} class="flex flex-col rounded-2xl border border-laterite-900/10 bg-white p-5 no-underline shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                    <span class="font-black text-laterite-900">{c.h1}</span>
                    <span class="mt-2 text-sm leading-7 text-laterite-900/65">{c.description}</span>
                  </a>
                );
              })}
            </div>
          </section>
        );
      })}
      <div class="flex flex-wrap gap-3">
        <a href={`${base}/`} class="rounded-full bg-sea-900 px-5 py-3 font-extrabold text-white no-underline">{locale === 'en' ? 'Back to the main guide' : 'मुखेल मार्गदर्शकाक परत वचात'}</a>
      </div>
    </div>
  </div>
</BaseLayout>
