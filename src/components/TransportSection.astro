---
// सविस्तर प्रवास मार्गदर्शन – विमानतळ, रेल्वे, बस, टॅक्सी/भाड्याने वाहन.
// हो नाफायद्याचो प्रकल्प आसून खाजगी कॅब/भाडे कंपनीची नांवां शिफारस करिना;
// फकत प्रकार आनी साधारण अंतर/वेळ दिता (प्रत्यक्ष वेळ वाहतूक व हंगामाप्रमाणें बदलता).
import { type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const modesKok = [
  {
    "icon": "✈️",
    "title": "आपल्या विमानतळाथावन",
    "text": "आपल्या खऱ्या विमानतळाथावन चालू रस्त्याचो प्रवास तपासात. वाहन पुरवणदाराक मंजूर उतरपाची सुवात आनी परतीचें नियोजन विचारात; थेट सेवा वा ठरावीक वेळाची हमी ना."
  },
  {
    "icon": "🚆",
    "title": "आपल्या रेल्वे स्थानकाथावन",
    "text": "तिकीटावेलें स्थानक सुरवात म्हणून वापरात. फुडली चालू वाहतूक, शेवटली पायी वाट आनी परतीची सोय तपासात."
  },
  {
    "icon": "🚌",
    "title": "बस मार्ग",
    "text": "गोवा पर्यटन मापुसा–अंजुना–वागातोर बस मार्गाचो उल्लेख करता. तारीख नाशिल्लें पान वेळापत्रक न्हय; चालू मार्ग, थांबो, फेऱ्यो आनी परतीची सेवा पुरवणदाराक विचारात."
  },
  {
    "icon": "🛵",
    "title": "टॅक्सी वा भाड्याचें वाहन",
    "text": "मंजूर उतरपाची सुवात, पार्किंग आनी परतीची भेट सुवात ठरयात. नकाशांतलो बिंदू किल्लो आसा; वाहनाच्या प्रवेशाची खात्री न्हय."
  }
];
const modesEn = [
  {
    "icon": "✈️",
    "title": "From your airport",
    "text": "Check the current road journey from your actual airport. Arrange the permitted drop-off and return with your transport provider; no direct service or fixed travel time is guaranteed here."
  },
  {
    "icon": "🚆",
    "title": "From your railway station",
    "text": "Use the station named on your ticket as the starting point. Check current onward transport, the last walking section and the return arrangement."
  },
  {
    "icon": "🚌",
    "title": "Bus connection",
    "text": "Goa Tourism describes a Mapusa–Anjuna–Vagator bus connection. Its undated destination page is not a timetable: confirm the current route, stop, frequency and return service with the operator."
  },
  {
    "icon": "🛵",
    "title": "Taxi or hired vehicle",
    "text": "Agree a lawful drop-off, parking and return meeting point before relying on a vehicle reaching the approach. The map pin is the fort, not a guaranteed vehicle entrance."
  }
];

const distancesKok = [
  [
    "मापुसा",
    "गोवा पर्यटन सुमार 10 किमी म्हणटा; तुमच्या सुरवातीथावन मापिल्लो प्रवास न्हय."
  ]
];
const distancesEn = [
  [
    "Mapusa",
    "Goa Tourism describes about 10 km; not a measured journey from your origin."
  ]
];

const L = locale === 'en'
  ? { eyebrow: 'Getting here in detail', heading: 'Mapusa–Vagator route, then on foot', intro: 'Chapora Fort is close to Vagator, Anjuna and Mapusa. Check the actual approach and current access before choosing transport.', distTitle: 'Approximate distance (by road)', distNote: 'Distances are approximate; actual time varies with traffic, season and road — check live traffic in maps.', finalTitle: 'Final on-foot climb', finalText: 'From the base parking/road the path up to the fort is short but steep. There is little shade on hot days; carry water, keep hands free and avoid slippery footwear. In monsoon the laterite rock and soil can be slippery — wear sturdy footwear.' }
  : { eyebrow: 'सविस्तर प्रवास', heading: 'मापुसा–वागातोर मार्ग, मागीर पायी चडण', intro: 'चापोरा किल्लो वागातोर, अंजुना आनी मापुसा हांच्या जवळ आसा. वाहतूक निवडचे आदी खरी वाट आनी चालू रसद तपासात.', distTitle: 'साधारण अंतर (रस्त्यान)', distNote: 'अंतर साधारण आसात; प्रत्यक्ष वेळ वाहतूक, हंगाम आनी रस्त्याप्रमाणें बदलता – नकाशांत चालू वाहतूक तपासात.', finalTitle: 'शेवटची पायी चडण', finalText: 'पायथ्याच्या पार्किंग/रस्त्या थावन किल्ल्याचेर वचपी वाट छोटी पूण उंच आसा. उश्ण दिवसांत सावली कमी मेळटा; उदक घेवात, हात मोकळे दवरात आनी निसरड्या पादत्राणां टाळात. पावसाळ्यांत लेटराइट दगड आनी माती निसरडी जावंक शकता – घट्ट पादत्राणां वापरात.' };

const modes = locale === 'en' ? modesEn : modesKok;
const distances = locale === 'en' ? distancesEn : distancesKok;
---
<section id="transport" class="bg-sand-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr]">
      <div>
        <p class="text-sm font-black uppercase tracking-[.18em] text-sea-700">{L.eyebrow}</p>
        <h2 class="mt-3 text-4xl font-black text-laterite-900 sm:text-5xl">{L.heading}</h2>
        <p class="mt-5 text-lg leading-8 text-laterite-900/75">{L.intro}</p>
        <div class="mt-7 rounded-3xl border border-laterite-900/10 bg-white p-6 shadow-sm">
          <h3 class="text-base font-black uppercase tracking-[.14em] text-laterite-500">{L.distTitle}</h3>
          <ul class="mt-4 divide-y divide-laterite-900/10 text-sm">
            {distances.map(([place, d]) => (
              <li class="flex items-center justify-between gap-4 py-2.5"><span class="font-bold text-laterite-900">{place}</span><span class="text-laterite-900/65">{d}</span></li>
            ))}
          </ul>
          <p class="mt-3 text-xs text-laterite-900/55">{L.distNote}</p>
        </div>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {modes.map((m) => (
          <article class="rounded-3xl border border-laterite-900/10 bg-white p-6 shadow-sm">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sea-500/12 text-2xl" aria-hidden="true">{m.icon}</div>
            <h3 class="mt-4 text-xl font-black text-laterite-900">{m.title}</h3>
            <p class="mt-3 leading-7 text-laterite-900/70">{m.text}</p>
          </article>
        ))}
        <article class="rounded-3xl border border-laterite-900/10 bg-white p-6 shadow-sm sm:col-span-2">
          <h3 class="text-xl font-black text-laterite-900">{L.finalTitle}</h3>
          <p class="mt-3 leading-7 text-laterite-900/70">{L.finalText}</p>
        </article>
      </div>
    </div>
  </div>
</section>
