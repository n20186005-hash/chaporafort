---
// किल्ल्याच्यो कथा, परंपरा आनी सांस्कृतिक नोंदी.
// ऐतिहासिक उल्लेख आनी परंपरागत कथा हांचे मदलो फरक 'प्रकार' बॅजांतल्यान दाखयल्लो आसा.
const stories = [
  {
    kind: 'नांव-उत्पत्ती',
    icon: '🏷️',
    title: '‘चापोरा’ हें नांव कशें पडलें?',
    body: 'अशी नोंद आसा की आदिलशाही (बिजापूर सल्तनत) राजवटींत ही जागा ‘शाहापुरा’ म्हणून वळखताली – अर्थ ‘राजाचें नगर’. काळांतरान हें नांव स्थानिक उच्चारांत ‘शापोरा / चापोरा’ अशें रूपांतर जालें. चापोरा न्हंय आनी न्हंयेच्या तोंडा वयलो हो डोंगर ह्या नांवांचो आपसांत संबंद आसा, अशें गोवा पर्यटन विकास महामंडळाच्या अधिकृत पानार मेळटा.',
    source: 'गोवा पर्यटन विकास महामंडळ (GTDC) – चापोरा किल्लो'
  },
  {
    kind: 'ऐतिहासिक नोंद',
    icon: '📜',
    title: 'दोन घुरयो आनी एके सीमेची गोष्ट',
    body: 'गोवा पर्यटनाच्या अधिकृत माहितीप्रमाणें ह्या किल्ल्याचेर 1684 आनी 1739 ह्या दोन वेळार मराठ्यांनी ताबो घेतलो. उपरांत 1741 च्या ‘नव्या जैतां’ (नोव्हास काँक्विस्टास) म्हणून वळखतलेल्या अभियानांत पुर्तुगेजांनी किल्लो परत जिंकलो आनी उत्तरेकडलो पेर्नेम प्रदेश लागीं केलो. तेन्नाच्यान पुर्तुगी गोव्याची सीमा उत्तरेक चापोरा न्हंयेच्या पलिकडे सरकली, जाका लागून हो किल्लो आपलें मुखेल सीमा-रक्षणाचें कारण गमयलो; 1892 त तो सैनिकी दृष्टीन सोडून दिलो.',
    source: 'गोवा पर्यटन विकास महामंडळ (GTDC) आनी गोवा सरकार'
  },
  {
    kind: 'स्थानीय कथा',
    icon: '🦎',
    title: 'संभाजी राजा आनी व्हड सरड्यांची खेळी',
    body: 'स्थानीय परंपरेंत अशी कथा आसा की 1684 च्या आक्रमणावेळार संभाजी राजाच्या सैनिकांनी किल्ल्याचेर चडपा खातीर व्हड सरड्यांचो (मॉनिटर लिझार्ड) आदार घेतलो. पुर्तुगी सरदार ही युक्ती पळोवन विस्मयांत पडलो आनी एकोय गोळी ना मारत किल्लो सुपूर्द केलो, अशें सांगतात. हो उल्लेख गोवा पर्यटनाच्या अधिकृत पानारूय आसा, पूण तो परंपरेची कथा म्हणून पळोवचो.',
    source: 'गोवा पर्यटन विकास महामंडळ (GTDC) – परंपरागत कथा'
  },
  {
    kind: 'चित्रपट-संस्कृती',
    icon: '🎬',
    title: "‘दिल चाहता है’ (2001) आनी किल्ल्याचें नवें पर्व",
    body: '2001 च्या ‘दिल चाहता है’ ह्या हिंदी चित्रपटांतलीं शेवटचीं दृश्यां ह्याच किल्ल्यावेल्यान चित्रित जाल्लीं. त्या उपरांत हो किल्लो ‘दिल चाहता है किल्लो’ ह्या टोपणनांवान देश-विदेशांत प्रसिद्ध जालो आनी तरणाट्यांच्या पिढयेक ह्या ठिकाणाची वळख जाली. आयज गोवा पर्यटन ताका चित्रपट-संस्कृतीचो वारसो म्हणून दाखयता.',
    source: 'गोवा पर्यटन विकास महामंडळ (GTDC) / विकिपीडिया नोंद'
  },
  {
    kind: 'स्थापत्य',
    icon: '🏰',
    title: '1717 ची पुनर्बांधणी आनी भूमिगत वाट',
    body: 'पुर्तुगेजांनी 1717 चेर किल्ल्याची मोठी पुनर्बांधणी केली – डोंगराच्या उताराक धरून वळपी तटबंदी, अनियमित आंतराचे बुरुज, तोफां खातीर खोल जागा आनी बुरुजांचेर दंडगोलाकार मिनारे. ह्याच काळांत न्हंयेच्या कुशीक वचपी खास आपत्कालीन भूमिगत वाटूय तयार केली; घेरावाच्या वेळार तिचो उपेग पुरवण वा माघार घेवपा खातीर जातालो असो उल्लेख मेळटा. ह्या वाटेचो प्रवेशद्वार आयजूय किल्ल्याच्या आतल्या भागांत दिसता.',
    source: 'गोवा पर्यटन विकास महामंडळ (GTDC) / विकिपीडिया नोंद'
  }
];
---
<section id="कथा" class="bg-laterite-100 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div>
        <p class="text-sm font-black uppercase tracking-[.18em] text-laterite-500">किल्ल्याच्यो कथा आनी कल्पित कथा</p>
        <h2 class="mt-3 max-w-3xl text-4xl font-black tracking-tight text-laterite-900 sm:text-5xl">‘शाहापुरा’ थावन ‘दिल चाहता है’ मेरेन – तटबंदीच्या फाटल्यो कथा</h2>
      </div>
    </div>
    <div class="mt-9 grid gap-5 md:grid-cols-2">
      {stories.map((s) => (
        <article class="rounded-[2rem] bg-white p-6 shadow-sm ring-1 ring-laterite-900/10 sm:p-7">
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-2 rounded-full bg-sea-500/12 px-3 py-1 text-xs font-black text-sea-700"><span aria-hidden="true">{s.icon}</span>{s.kind}</span>
          </div>
          <h3 class="mt-4 text-2xl font-black text-laterite-900">{s.title}</h3>
          <p class="mt-3 text-[0.98rem] leading-8 text-laterite-900/75">{s.body}</p>
          <p class="mt-4 border-t border-laterite-900/10 pt-3 text-xs font-bold text-laterite-900/55">स्रोत: {s.source}</p>
        </article>
      ))}
    </div>
    <p class="mt-6 max-w-3xl text-sm leading-7 text-laterite-900/60">कांय कथा परंपरेचेर आदारीत आसून नवें संशोधन तांच्यांत बदल हाडूंक शकता. वयलो मजकूर प्राथमिक/अधिकृत स्रोतांकडल्यान एकठांय केल्लो आसा; पुराय यादी पानाच्या तळाक ‘संदर्भ’ भागांत दिल्या.</p>
  </div>
</section>
