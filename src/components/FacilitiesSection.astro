---
// सुविधा विभाग – किल्लो व आसपास उपलब्ध असोवपी सामान्य सोयी.
// हो नाफायद्याचो प्रकल्प आसून कसलोच खाजगी उपक्रम/दुकान/रेस्टॉरंट/सेवा प्रदाता
// शिफारस करीना – फकत प्रकार आनी सामान्य मार्गदर्शन दिता.
import { type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const facilitiesKok = [
  {
    "icon": "🚻",
    "title": "शौचालय",
    "text": "शौचालयाची सध्याची सुवात आनी उपलब्धताय निघचे आदी विचारात; किल्ल्यांत वा भोंवतणी खात्रीची सोय आसा वा ना अशें गृहीत धरूं नाकात."
  },
  {
    "icon": "🅿️",
    "title": "पार्किंग",
    "text": "मंजूर पार्किंग, शुल्क आनी चडणेकडेन शेवटली वाट स्थानिक व्यवस्थापनाक विचारात. जागेची हमी ना."
  },
  {
    "icon": "🍽️",
    "title": "जेवण / उपाहार",
    "text": "जेवणाचें नियोजन करतना निवडिल्ल्या सुवातेचे सध्याचे वेळ, किंमत आनी स्वच्छताय तपासात. उदक सोबत दवरात."
  },
  {
    "icon": "🛏️",
    "title": "रावपाची सोय",
    "text": "रावपाची सुवात, बुकिंग अटी आनी किल्ल्याकडेन प्रवास तपासून निवडात. ही पडताळिल्ली हॉटेल यादी न्हय."
  },
  {
    "icon": "🛍️",
    "title": "खरेदी / दुकानां",
    "text": "दुकान उगडें आसतलें वा वस्तू मेळटली अशें गृहीत धरूं नाकात; गरजेच्यो वस्तू पयलींच घेयात."
  },
  {
    "icon": "⛽",
    "title": "इंधन / EV चार्जिंग",
    "text": "प्रवासाआदी आपल्या पुरवणदाराकडल्यान इंधन वा चार्जिंगची ताजी माहिती तपासात. हांगा लागींचो चार्जिंग पॉइंट पडताळिल्लो ना."
  },
  {
    "icon": "🏧",
    "title": "पयशे / ATM",
    "text": "ATM वा डिजिटल पेमेंटाचेर आदारून रावचे आदी बँक आनी विक्रेत्याक सध्याची सोय विचारात."
  },
  {
    "icon": "🏥",
    "title": "आरोग्य / फार्मसी",
    "text": "आपल्यो वैयक्तिक आरोग्य गरजो पयलींच तयार करात. गरज पडटकीं स्थानिक कर्मचारी आनी सध्याच्या आपत्कालीन सेवेकडेन मदत मागात."
  },
  {
    "icon": "📶",
    "title": "मोबाईल / इंटरनेट",
    "text": "नकाशो आदींच उतरयात; ह्या मार्गदर्शकान किल्ल्यावेली मोबाईल रांग वा इंटरनेट उपलब्धताय पडताळिल्ली ना."
  },
  {
    "icon": "💧",
    "title": "उदक / विसवो",
    "text": "पिवपाचें उदक सोबत दवरात. भरपाची सोय, बसपाची सुवात वा सावळी मेळटली अशें गृहीत धरूं नाकात."
  }
];
const facilitiesEn = [
  {
    "icon": "🚻",
    "title": "Toilets",
    "text": "Ask about the current location and availability of toilets before setting out. Do not assume verified provision or absence inside the fort or nearby."
  },
  {
    "icon": "🅿️",
    "title": "Parking",
    "text": "Ask locally about authorised parking, charges and the final route to the climb. No space is guaranteed."
  },
  {
    "icon": "🍽️",
    "title": "Food / eateries",
    "text": "Check the selected venue’s current opening, prices and hygiene when arranging food. Carry water."
  },
  {
    "icon": "🛏️",
    "title": "Where to stay",
    "text": "Check the exact property, booking terms and journey to the fort. This is not a verified accommodation directory."
  },
  {
    "icon": "🛍️",
    "title": "Shopping / shops",
    "text": "Do not rely on a shop being open or a product being available; obtain essentials in advance."
  },
  {
    "icon": "⛽",
    "title": "Fuel / EV charging",
    "text": "Check your provider’s current fuel or charging information before travelling. No nearby charging point has been verified here."
  },
  {
    "icon": "🏧",
    "title": "Money / ATM",
    "text": "Check your bank and seller’s current arrangements before relying on an ATM or digital payment."
  },
  {
    "icon": "🏥",
    "title": "Health / pharmacy",
    "text": "Prepare for personal medical needs. Seek local staff and current emergency-service assistance when needed."
  },
  {
    "icon": "📶",
    "title": "Mobile / internet",
    "text": "Download a map ahead of time. Mobile reception and internet availability at the fort have not been surveyed by this guide."
  },
  {
    "icon": "💧",
    "title": "Water / rest",
    "text": "Carry drinking water. Do not assume a refill point, seating or shade will be available."
  }
];

const L = locale === 'en'
  ? {
      eyebrow: 'Visitor facilities',
      heading: 'Facilities: questions to check before travelling',
      disclaimer: 'Planning checklist; not a verified service inventory',
      note: 'This guide is non-commercial and does not recommend any private venture, shop, restaurant, lodging or service provider. The information above is general by type; verify the exact place, opening hours and current availability on site or in maps.'
    }
  : {
      eyebrow: 'भेटेची सोयी',
      heading: 'प्रवासाआदी सोयींची माहिती विचारात',
      disclaimer: 'नियोजनाची यादी; पडताळिल्ली सोय यादी न्हय',
      note: 'हें मार्गदर्शक नाफायद्याचें आसून कोणाचोय खाजगी उपक्रम, दुकान, रेस्टॉरंट, वसतिगृह वा सेवा प्रदाता शिफारस करिना. वयर दिल्ली माहिती सामान्य प्रकाराची आसा; अचूक जागा, उगडपाची वेळ आनी ताजी उपलब्धता सुवातीचेर वा नकाशांत तपासात.'
    };

const facilities = locale === 'en' ? facilitiesEn : facilitiesKok;
---
<section id="facilities" class="bg-sea-900 py-20 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div>
        <p class="text-sm font-black uppercase tracking-[.18em] text-sea-300">{L.eyebrow}</p>
        <h2 class="mt-3 max-w-3xl text-4xl font-black tracking-tight sm:text-5xl">{L.heading}</h2>
      </div>
      <span class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-white/10 px-4 py-2 text-xs font-bold text-sea-100 ring-1 ring-white/15 md:self-auto">{L.disclaimer}</span>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {facilities.map((f) => (
        <article class="rounded-3xl bg-white/8 p-6 ring-1 ring-white/12">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/12 text-2xl" aria-hidden="true">{f.icon}</div>
          <h3 class="mt-4 text-xl font-black text-white">{f.title}</h3>
          <p class="mt-2 text-sm leading-7 text-sea-100/80">{f.text}</p>
        </article>
      ))}
    </div>
    <aside class="mt-8 rounded-3xl border border-sand-300/30 bg-sand-100/10 p-6 text-sm leading-7 text-sand-100/85">{L.note}</aside>
  </div>
</section>
