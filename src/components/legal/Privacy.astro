---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withSiteName } from '../../data/site';
import { type Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const L = locale === 'en'
  ? {
      title: 'Privacy policy', desc: 'Privacy policy of the Chapora Fort tourist guide.',
      updated: 'Last updated: September 2026',
      h1: 'Privacy policy',
      intro: 'This independent tourist-information site tries to handle the minimum information needed to provide the service.',
      h2a: 'What information we may collect', a: ['Visit technical information such as IP address, browser type and pages opened.', 'Preferences in cookies and similar local-storage technologies.', 'Information you voluntarily provide by email or other contact, if such a contact method is used.'],
      h2b: 'Use of information', b: ['Improve content, performance and the usage experience.', 'Understand aggregated usage patterns if you give permission.', 'Respond to requests.', 'Meet applicable legal duties.'],
      h2c: 'Third-party services', c: 'Google Maps is used to show location. Google Analytics starts only if you accept analytics cookies. These services have their own privacy policies.',
      h2d: 'Your rights', d: 'Where applicable laws such as GDPR or similar rules apply, you may have rights to access, correct, delete, restrict or object to the processing of your personal data, and to complain to a competent regulator.',
      h2e: 'Storage and security', e: 'There is no intent to keep more information than needed. Cookie preferences in the browser are kept in local storage on your device. No method on the internet is fully secure, so reasonable technical care is taken.',
      h2f: 'Contact', f: 'This version has no contact form, account or registration. If a public contact channel is added later, information you voluntarily provide will be used only to reply to that request.'
    }
  : {
      title: 'गोपनीयता धोरण', desc: 'चापोरा किल्ला प्रवासी मार्गदर्शकाचें गोपनीयता धोरण.',
      updated: 'शेवटचें अद्ययावत: सप्टेंबर 2026',
      h1: 'गोपनीयता धोरण',
      intro: 'हें स्वतंत्र प्रवासी माहिती संकेतथळ सेवा दितना लागपी कमीत कमी माहितीच हाताळपाचो प्रयत्न करता.',
      h2a: 'आमी कोणती माहिती गोळा करूं शकतात', a: ['भेटीची तांत्रिक माहिती, जशी आयपी पत्तो, ब्राउझर प्रकार आनी उगडिल्ली पानां.', 'कुकी आनी तशाच स्थानिक साठवण तंत्रज्ञानांतली पसंती.', 'तुमी ईमेल वा इतर संपर्क मार्गान स्वेच्छेन दिलेली माहिती, जर अशें संपर्क साधन वापरलें जाल्यार.'],
      h2b: 'माहितीचो वापर', b: ['सामग्री, कार्यक्षमता आनी वापराचा अनुभव सुदारप.', 'तुमी परवानगी दिल्यार एकत्रित वापर पद्धती समजून घेवप.', 'मागण्यांक उत्तर दिवप.', 'लागू कायदेशीर कर्तव्यां पाळप.'],
      h2c: 'तिसऱ्या पक्षाच्या सेवा', c: 'संकेतथळार ठिकाण दाखोवपाक गुगल नकाशो वापरला आसा. विश्लेषण कुकींक तुमी मान्यताय दिल्यारच गुगल अॅनालिटिक्स सुरू जाता. ह्या सेवांची स्वतंत्र गोपनीयता धोरणां लागू जातात.',
      h2d: 'तुमचे हक्क', d: 'लागू कायदे, जीडीपीआर वा तत्सम नियम लागू जात आसल्यार, तुमकां तुमच्या वैयक्तिक माहितीचेर प्रवेश, दुरुस्ती, मिटोवप, प्रक्रिया मर्यादित करप वा प्रक्रियेक आक्षेप घेवप हक्क आसूंक शकतात. योग्य नियामक प्राधिकरणाक तक्रार करपाचो हक्कूय आसूंक शकता.',
      h2e: 'साठवण आनी सुरक्षा', e: 'गरजेपेक्षा जास्त माहिती राखून दवरपाचो उद्देश ना. ब्राउझरांतली कुकी पसंती तुमच्या उपकरणार स्थानिक साठवणीत दवरली जाता. इंटरनेटार कसलोच उपाय पूर्ण सुरक्षित म्हणूंक येना, म्हणून वाजवी तांत्रिक खबरदारी घेतली जाता.',
      h2f: 'संपर्क माहिती', f: 'ह्या आवृत्तीत संपर्क फॉर्म, खातें वा नोंदणी व्यवस्था ना. भविष्यात सार्वजनिक संपर्क मार्ग जोडला जाल्यार, तुमी स्वेच्छेन दिलेली माहिती फकत त्या विनंतीक उत्तर दिवपाखातीर वापरली वतली.'
    };
---
<BaseLayout title={withSiteName(L.title)} description={L.desc} locale={locale}>
  <section class="bg-sand-50 py-16 lg:py-24"><article class="prose-legal mx-auto max-w-3xl px-5 lg:px-8">
    <p class="text-sm font-black text-laterite-500">{L.updated}</p>
    <h1 class="mt-3 text-4xl font-black text-laterite-900 sm:text-5xl">{L.h1}</h1>
    <p class="mt-6 text-lg">{L.intro}</p>
    <h2>{L.h2a}</h2><ul>{L.a.map((x) => <li>{x}</li>)}</ul>
    <h2>{L.h2b}</h2><ul>{L.b.map((x) => <li>{x}</li>)}</ul>
    <h2>{L.h2c}</h2><p>{L.c}</p>
    <h2>{L.h2d}</h2><p>{L.d}</p>
    <h2>{L.h2e}</h2><p>{L.e}</p>
    <h2>{L.h2f}</h2><p>{L.f}</p>
  </article></section>
</BaseLayout>
