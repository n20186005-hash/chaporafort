---
import Logo from './Logo.astro';
---
<header class="sticky top-0 z-50 border-b border-laterite-900/10 bg-sand-50/92 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-3 lg:px-8">
    <Logo />
    <nav aria-label="मुखेल नेव्हिगेशन" class="hidden items-center gap-5 text-sm font-bold text-laterite-900 md:flex">
      <a class="hover:text-laterite-500" href="/#इतिहास">इतिहास</a>
      <a class="hover:text-laterite-500" href="/#भेट">भेट नियोजन</a>
      <a class="hover:text-laterite-500" href="/#प्रवास">कशें पावचें</a>
      <a class="hover:text-laterite-500" href="/#भोंवतणी">भोंवतणी</a>
      <a class="hover:text-laterite-500" href="/#प्रश्नोत्तर">प्रश्नोत्तर</a>
    </nav>
    <a href="https://maps.app.goo.gl/3z6axsvdHe2spoFg8" rel="noopener noreferrer" target="_blank" class="rounded-full bg-sea-900 px-4 py-2 text-sm font-extrabold text-white no-underline shadow-sm hover:bg-sea-700">नकाशो उगडात</a>
  </div>
</header>
