---
// चापोरा किल्ल्याचो आतांचो हवामान आनी ७ दिसांचो पूर्वानुमान.
// हो घटक सर्व्हर-साइड (बांधणी वेळार) Open-Meteo कडल्यान माहिती घेवन HTML म्हणून
// थेड रेंडर करता. किनारो/समुद्राची माहिती Marine API कडल्यान घेतात.
// दोनूय भासांतलो मजकूर `D` (सल्लो) आनी `H` (मथळ्यो) हांतूंत आसा.
import { LATITUDE, LONGITUDE } from '../data/site';
import { type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const WD = locale === 'en'
  ? ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
  : ['रवि', 'सोम', 'मंगळ', 'बुध', 'गुरु', 'शुक्र', 'शनि'];
const MON = locale === 'en'
  ? ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
  : ['जाने', 'फेब्रु', 'मार्च', 'एप्रि', 'मे', 'जून', 'जुल', 'ऑग', 'सप्टें', 'ऑक्टो', 'नोव्हें', 'डिसें'];

