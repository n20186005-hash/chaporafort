const wmInfo = (code: number) => {
  const x = WML[code] || { emoji: '🌡️', kok: 'हवामान माहिती उपलब्ध ना', en: 'Weather info unavailable' };
  return { emoji: x.emoji, label: locale === 'en' ? x.en : x.kok };
};

type WxCurrent = { temperature_2m: number; apparent_temperature: number; weather_code: number; wind_speed_10m: number };
type WxDaily = {
  time: string[]; weather_code: number[]; temperature_2m_max: number[]; temperature_2m_min: number[];
  precipitation_probability_max: (number | null)[]; sunrise: string[]; sunset: string[]; uv_index_max: number[];
};
type WxPayload = { current: WxCurrent; daily: WxDaily };

let weather: WxPayload | null = null;
let fetchError = false;
let sea: { wave_height?: number; sea_surface_temperature?: number } | null = null;
try {
  const url =
    `https://api.open-meteo.com/v1/forecast?latitude=${LATITUDE}&longitude=${LONGITUDE}` +
    `&current=temperature_2m,apparent_temperature,weather_code,wind_speed_10m` +
    `&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset,uv_index_max` +
    `&timezone=Asia%2FKolkata&forecast_days=7&wind_speed_unit=kmh`;
  const res = await fetch(url, { signal: AbortSignal.timeout(15000) });
  if (res.ok) weather = (await res.json()) as WxPayload;
  else fetchError = true;
} catch {
  fetchError = true;
}
try {
  const murl =
    `https://marine-api.open-meteo.com/v1/marine?latitude=${LATITUDE}&longitude=${LONGITUDE}` +
    `&current=wave_height,sea_surface_temperature&timezone=Asia%2FKolkata`;
  const mres = await fetch(murl, { signal: AbortSignal.timeout(10000) });
  if (mres.ok) {
    const j = (await mres.json()) as { current?: { wave_height?: number; sea_surface_temperature?: number } };
    sea = j.current ?? null;
  }
} catch {
  /* समुद्राची माहिती पर्यायी आसा */
}

const B = [1, 6, 12, 20, 29, 39, 50, 62, 75, 89, 103, 118];
const beaufort = (kmh: number) => B.filter((b) => kmh >= b).length;
const uvLabel = (uv: number) => (locale === 'en'
  ? (uv >= 8 ? 'Very high' : uv >= 5 ? 'High' : uv >= 3 ? 'Moderate' : 'Low')
  : (uv >= 8 ? 'खूब चड' : uv >= 5 ? 'चड' : uv >= 3 ? 'मध्यम' : 'कमी'));

