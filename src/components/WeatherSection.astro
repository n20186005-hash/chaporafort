      intro: 'चडण, दृश्यां आनी सूर्यास्त – हीं सगळीं हवामानाचेर अवलंबून आसात. किल्ल्याचेर हवो उघडो आनी कड्याचेर सावली कमी आसता; निघचे आदी हवामान पळयतात.',
      cardBest: 'सगळ्यांत बरी वेळ', cardBestText: 'ऑक्टोबर ते मार्च ही कोरडी आनी सुखद वेळ. सांजवेळ सूर्यास्ता खातीर सगळ्यांत बरी; गर्दीय चड आसता.',
      cardSummer: 'उन्हाळो (एप्रिल–मे)', cardSummerText: 'दीस उश्ण आनी दमट आसतात. पहाटेचेर वा सांजे वचात; उदक, टोपी आनी सूर्यापासून संरक्षण सोबत दवरात.',
      cardMonsoon: 'पावसाळो (जून–सप्टेंबर)', cardMonsoonText: 'मुसळधार वर्साद आनी वाट निसरडी जावंक शकता. घट्ट पादत्राणां, अस्तुरो आनी सावधानेक देंवता.',
      curWeather: 'आयचें हवामान', precip: 'आयज पावसाची शक्यताय', wind: 'वारो', uv: 'UV (अतिनील)', feels: 'जाणवपी तापमान',
      riskTitle: '⚠️ सावधानताय (हवामानावयल आदारीत)', tabDress: 'आंग-भेस / प्रवास', tabAct: 'खेळ / भोंवडी', tabItems: 'सोबत घेवपाचें',
      forecast7: 'पुढिल्ले ७ दीस', todayBadge: 'आयजचो अंदाज', srss: 'सूर्योदय / सूर्यास्त', uvmax: 'UV कमाल सूचकांक आयज',
      noData: 'हवामानाचो अंदाज सद्या उपलब्ध ना; वरील ऋतू-सल्लो आनी ‘कालानुरूप भेटीची योजना’ भाग पळयात. निघचे आदी स्थानिक हवामान तपासात.',
      note: 'हवामानाचो अंदाज आसा – प्रत्यक्ष परिस्थिती वेगळी आसूंक शकता. यात्रा करचे आदी नवीनतम पूर्वानुमान तपासात.'
    };

const tabs: { id: string; label: string; items: string[] }[] = [];
if (advice && advice.dress.length) tabs.push({ id: 'dress', label: H.tabDress, items: advice.dress });
if (advice && advice.activity.length) tabs.push({ id: 'act', label: H.tabAct, items: advice.activity });
if (advice && advice.items.length) tabs.push({ id: 'items', label: H.tabItems, items: advice.items });

const fmtTime = (iso: string) => {
  const m = iso.match(/T(\d{2}):(\d{2})/);
  if (!m) return '';
  const h = Number(m[1]);
  const mm = m[2];
  const h12 = h % 12 === 0 ? 12 : h % 12;
  return locale === 'en' ? `${h >= 12 ? 'PM' : 'AM'} ${h12}:${mm}` : `${h >= 12 ? 'सं' : 'सकाळ'} ${h12}:${mm}`;
};
const days =
  weather?.daily.time.map((t, i) => {
    const [y, mo, d] = t.split('-').map(Number);
    const dt = new Date(Date.UTC(y, mo - 1, d, 12));
    const w = wmInfo(weather!.daily.weather_code[i]);
    const pr = weather!.daily.precipitation_probability_max[i];
    return {
      wd: WD[dt.getUTCDay()],
      dateLabel: `${d} ${MON[mo - 1]}`,
      emoji: w.emoji,
      label: w.label,
      min: Math.round(weather!.daily.temperature_2m_min[i]),
      max: Math.round(weather!.daily.temperature_2m_max[i]),
      pr: pr != null ? `${pr}%` : '—',
      sunrise: fmtTime(weather!.daily.sunrise[i]),
      sunset: fmtTime(weather!.daily.sunset[i]),
      uv: weather!.daily.uv_index_max[i]
    };
  }) || [];
---
<script is:inline>
  (function () {
    var root = document.getElementById('wx-tabs');
    if (!root) return;
    var btns = root.querySelectorAll('[data-tab]');
    var panels = root.querySelectorAll('[data-panel]');
    function activate(id) {
      btns.forEach(function (b) {
        var on = b.getAttribute('data-tab') === id;
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        b.classList.toggle('bg-laterite-900', on);
        b.classList.toggle('text-white', on);
        b.classList.toggle('bg-white', !on);
        b.classList.toggle('text-laterite-900', !on);
      });
      panels.forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== id; });
    }
    btns.forEach(function (b) { b.addEventListener('click', function () { activate(b.getAttribute('data-tab')); }); });
    var first = root.querySelector('[data-tab]');
    if (first) activate(first.getAttribute('data-tab'));
  })();
</script>
<section id="weather" class="bg-laterite-100 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <p class="text-sm font-black uppercase tracking-[.18em] text-laterite-500">{H.eyebrow}</p>
    <h2 class="mt-3 max-w-3xl text-4xl font-black tracking-tight text-laterite-900 sm:text-5xl">{H.title}</h2>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-laterite-900/70">{H.intro}</p>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <article class="rounded-3xl border border-laterite-900/10 bg-white p-6 shadow-sm">
        <h3 class="text-lg font-black text-laterite-900">{H.cardBest}</h3>
        <p class="mt-2 text-sm leading-7 text-laterite-900/70">{H.cardBestText}</p>
      </article>
      <article class="rounded-3xl border border-laterite-900/10 bg-white p-6 shadow-sm">
        <h3 class="text-lg font-black text-laterite-900">{H.cardSummer}</h3>
        <p class="mt-2 text-sm leading-7 text-laterite-900/70">{H.cardSummerText}</p>
      </article>
      <article class="rounded-3xl border border-laterite-900/10 bg-white p-6 shadow-sm">
        <h3 class="text-lg font-black text-laterite-900">{H.cardMonsoon}</h3>
        <p class="mt-2 text-sm leading-7 text-laterite-900/70">{H.cardMonsoonText}</p>
      </article>
    </div>

    {
      weather ? (
        <div class="mt-8 space-y-6">
          <article class="rounded-[2rem] border border-laterite-900/10 bg-white p-6 shadow-sm sm:p-7">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="text-sm font-black uppercase tracking-[.15em] text-laterite-500">{H.curWeather}</p>
                <div class="mt-3 flex flex-wrap items-center gap-4">
                  <span class="text-6xl leading-none" role="img" aria-label={wmInfo(weather.current.weather_code).label}>{wmInfo(weather.current.weather_code).emoji}</span>
                  <div>
                    <strong class="block text-5xl font-black text-laterite-900">{Math.round(weather.current.temperature_2m)}°C</strong>
                    <span class="mt-1 block font-bold text-sea-700">{wmInfo(weather.current.weather_code).label}</span>
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                <div class="rounded-2xl bg-sand-100/80 p-3"><span class="block text-xs text-laterite-900/60">{H.precip}</span><strong class="text-lg text-laterite-900">{weather.daily.precipitation_probability_max[0] ?? 0}%</strong></div>
                <div class="rounded-2xl bg-sand-100/80 p-3"><span class="block text-xs text-laterite-900/60">{H.wind}</span><strong class="text-lg text-laterite-900">{Math.round(weather.current.wind_speed_10m)} {locale === 'en' ? 'km/h' : 'किमी/ता'}</strong><span class="text-xs text-laterite-900/55">{beaufort(weather.current.wind_speed_10m)} {locale === 'en' ? 'level' : 'श्रेणी'}</span></div>
                <div class="rounded-2xl bg-sand-100/80 p-3"><span class="block text-xs text-laterite-900/60">{H.uv}</span><strong class="text-lg text-laterite-900">{weather.daily.uv_index_max[0]} · {uvLabel(weather.daily.uv_index_max[0])}</strong></div>
                <div class="rounded-2xl bg-sand-100/80 p-3"><span class="block text-xs text-laterite-900/60">{H.feels}</span><strong class="text-lg text-laterite-900">{Math.round(weather.current.apparent_temperature)}°C</strong></div>
              </div>
            </div>

            {
              advice && advice.risk.length > 0 && (
                <div class="mt-5 rounded-2xl border border-red-300 bg-red-50 p-4">
                  <p class="text-sm font-black uppercase tracking-[.12em] text-red-700">{H.riskTitle}</p>
                  <ul class="mt-2 space-y-1.5 text-sm font-semibold text-red-900/90">
                    {advice.risk.map((r) => <li>{r}</li>)}
                  </ul>
                </div>
              )
            }

            {
              tabs.length > 0 && (
                <div id="wx-tabs" class="mt-5">
                  <div class="flex flex-wrap gap-2" role="tablist">
                    {tabs.map((t, i) => (
                      <button type="button" data-tab={t.id} role="tab" aria-selected={i === 0 ? 'true' : 'false'}
                        class:list={['rounded-full px-4 py-2 text-sm font-black shadow-sm ring-1 ring-laterite-900/10', i === 0 ? 'bg-laterite-900 text-white' : 'bg-white text-laterite-900']}>
                        {t.label}
                      </button>
                    ))}
                  </div>
                  <div class="mt-3 grid gap-3">
                    {tabs.map((t) => (
                      <div data-panel={t.id} role="tabpanel" class="rounded-2xl bg-sea-500/8 p-4">
                        <ul class="space-y-1.5 text-sm leading-7 text-laterite-900/80">
                          {t.items.map((it) => <li class="flex gap-2"><span class="font-black text-sea-700">✓</span><span>{it}</span></li>)}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              )
            }
          </article>

          <article class="rounded-[2rem] border border-laterite-900/10 bg-white p-6 shadow-sm sm:p-7">
            <p class="text-sm font-black uppercase tracking-[.15em] text-laterite-500">{H.forecast7}</p>
            <ul class="mt-4 divide-y divide-laterite-900/10 text-sm">
              {days.map((day, i) => (
                <li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 py-3">
                  <span class="w-36 shrink-0">
                    <span class="block font-black text-laterite-900">{day.wd} · {day.dateLabel}</span>
                    {i === 0 && <span class="text-xs font-bold text-sea-700">{H.todayBadge}</span>}
                  </span>
                  <span class="text-2xl leading-none" aria-hidden="true">{day.emoji}</span>
                  <span class="min-w-0 flex-1 truncate font-semibold text-laterite-900/75">{day.label}</span>
                  <span class="shrink-0 font-black text-laterite-900">{day.min}° / {day.max}°</span>
                  <span class="shrink-0 rounded-full bg-sea-500/12 px-2 py-0.5 font-bold text-sea-700">💧 {day.pr}</span>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-xs leading-6 text-laterite-900/55">{H.srss}: {days[0]?.sunrise} – {days[0]?.sunset} · {H.uvmax} {days[0]?.uv}.</p>
          </article>
        </div>
      ) : (
        <p class="mt-8 rounded-3xl border border-laterite-900/10 bg-white p-6 text-sm text-laterite-900/70 shadow-sm">{H.noData}</p>
      )
    }
    <p class="mt-5 text-xs leading-6 text-laterite-900/60">{H.note}</p>
  </div>
</section>
