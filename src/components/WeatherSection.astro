const S = D[locale];

type Advice = { risk: string[]; dress: string[]; activity: string[]; items: string[] };
function buildAdvice(): Advice {
  const c = weather!.current.weather_code;
  const tMax = Math.round(weather!.daily.temperature_2m_max[0]);
  const tMin = Math.round(weather!.daily.temperature_2m_min[0]);
  const prob = weather!.daily.precipitation_probability_max[0] ?? 0;
  const wind = weather!.current.wind_speed_10m;
  const lvl = beaufort(wind);
  const uv = weather!.daily.uv_index_max[0];
  const diff = tMax - tMin;

  const isThunder = [95, 96, 99].includes(c);
  const isFog = [45, 48].includes(c);
  const isClear = [0, 1].includes(c);
  const isCloudy = c === 3;
  const isPartly = c === 2;
  const isDrizzle = [51, 53, 55, 56, 57].includes(c);
  const isRainLight = [61, 63, 66, 71, 73, 75, 77, 80, 81, 85, 86].includes(c) || isDrizzle;
  const isRainHeavy = [65, 67, 82].includes(c) || isThunder;
  const isRain = isRainLight || isRainHeavy;

  const risk: string[] = [];
  const dress: string[] = [];
  const activity: string[] = [];
  const set = new Set<string>();

  if (isRainHeavy) risk.push(S.riskRainHeavy);
  if (isThunder) risk.push(S.riskThunder);
  if (lvl >= 7) risk.push(S.riskWind);
  if (isFog) risk.push(S.riskFog);

  if (tMax <= 10) dress.push(S.dressCold);
  else if (diff > 8) dress.push(S.dressDiff(diff));
  if (tMax >= 32) dress.push(S.dressHot(tMax));
  if (uv >= 5) dress.push(S.dressUv);
  if (isRainHeavy) dress.push(S.dressRainHeavy);
  else if (isRain) dress.push(S.dressRain);
  else if (prob >= 60) dress.push(S.dressProb(prob));
  if (lvl >= 5 && lvl < 7) dress.push(S.dressWind(lvl));
  if (isClear || isPartly) dress.push(S.dressClear);
  if (isCloudy) dress.push(S.dressCloudy);

  if (isThunder) activity.push(S.actThunder);
  if (isRainHeavy) activity.push(S.actRainHeavy);
  else if (isRain || prob >= 60) activity.push(S.actRain);
  if (isFog) activity.push(S.actFog);
  if (tMax >= 32) activity.push(S.actHot);
  if (uv >= 5) activity.push(S.actUv);
  if (lvl >= 7) activity.push(S.actWind);
  if (isClear) activity.push(S.actClear);
  if (isCloudy || isPartly) activity.push(S.actCloudy);
  if (!activity.length) activity.push(S.actStable);
  if (sea && sea.sea_surface_temperature != null && sea.wave_height != null) {
    const st = Math.round(sea.sea_surface_temperature);
    const wh = Math.round(sea.wave_height * 10) / 10;
    activity.push(S.sea(st, wh));
  }

  if (isRainHeavy) set.add(S.itemRaincoat);
  if (isRainHeavy && lvl >= 5) set.add(S.itemRaincoatWind);
  else if (isRain) set.add(S.itemUmbrella);
  if (prob >= 60 && !isRain) set.add(S.itemUmbrellaProb);
  if (tMax >= 32 || uv >= 5) {
    set.add(S.itemSunscreen); set.add(S.itemGlasses); set.add(S.itemHat); set.add(S.itemWater);
  }
  if (diff > 8) set.add(S.itemJacket);
  if (tMax <= 10) { set.add(S.itemCoat); set.add(S.itemMuffler); }
  if (isFog) set.add(S.itemMask);

  return { risk, dress, activity, items: [...set] };
}

const advice: Advice | null = weather ? buildAdvice() : null;
