---
// कालानुरूप भेटीची योजना – हवामान, समुद्र/पाणी आनी वन्यजीव/निसर्गाचो साधारण अभ्यास.
// गोव्याच्या ऋतूंचेर आदारीत (स्थानिक हवामान-नमुने); कोणायचोच अधिकृत नोंद-संच
// नाका म्हणून "साधारण" म्हणून दिलां. प्रत्यक्ष भेटी आदी अधिकृत हवामान व किनारी
// सुचोवणी तपासात.
import { type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const rowsKok = [
  {
    "season": "उन आनी उश्णताय",
    "period": "",
    "weather": "चालू तापमान आनी UV पळयात.",
    "sea": "उश्ण दीस म्हळ्यार पोहपाची सुरक्षितताय न्हय.",
    "wildlife": "परवानगीच्या वाटेरून निसर्ग पळयात.",
    "advice": "उदक आनी उनापासून संरक्षण दवरात; उघड्या भागांत वेळ कमी करात."
  },
  {
    "season": "वर्साद आनी विजो",
    "period": "",
    "weather": "अधिकृत सूचना आनी ओली जमीन पळयात.",
    "sea": "किनारी व्यवस्थापन आनी जीवरक्षकांच्यो सूचना वेगळ्यो मानात.",
    "wildlife": "जनावरां पळोवपाखातीर अनोळखी जाग्यार वचूं नाकात.",
    "advice": "विजांच्या वेळार भक्कम आसरो घेयात आनी उघड्या भागाचो विचार बदलात."
  },
  {
    "season": "वारो आनी दिसप",
    "period": "",
    "weather": "फुडें वचचे आदी वारो आनी दिसप पळयात.",
    "sea": "लाटांचो मॉडेल पोहपाची सुरक्षितताय निश्चित करीना.",
    "wildlife": "जनावरां दिसपाची हमी ना.",
    "advice": "उघडे कडे टाळात आनी स्थानिक सूचना मानात."
  },
  {
    "season": "थंड परिस्थिती",
    "period": "",
    "weather": "चालू अंदाजाप्रमाणें कपडे निवडात.",
    "sea": "किनाऱ्याची रसद आनी झेंडे वेगळे तपासात.",
    "wildlife": "वस्तीस्थान आनी इतर भेटीदारांचो मान दवरात.",
    "advice": "दिनदर्शिकेपेक्षा गटाच्या गरजेप्रमाणें वाट आनी विसवो ठरयात."
  }
];
const rowsEn = [
  {
    "season": "Heat and sun",
    "period": "",
    "weather": "Check current temperature and UV.",
    "sea": "A warm day is not a swimming-safety assessment.",
    "wildlife": "Observe nature from permitted paths.",
    "advice": "Carry water, use sun protection and shorten exposed sections."
  },
  {
    "season": "Rain and thunderstorms",
    "period": "",
    "weather": "Check official warnings and actual wet surfaces.",
    "sea": "Follow beach authority and lifeguard instructions separately.",
    "wildlife": "Do not enter unmarked areas to seek wildlife.",
    "advice": "Seek substantial shelter during lightning and reconsider exposed sections."
  },
  {
    "season": "Wind and visibility",
    "period": "",
    "weather": "Assess current wind and visibility before continuing.",
    "sea": "A wave-height model does not confirm safe bathing.",
    "wildlife": "No wildlife sighting is promised.",
    "advice": "Keep clear of exposed edges and follow local instructions."
  },
  {
    "season": "Cooler conditions",
    "period": "",
    "weather": "Choose layers using the actual forecast.",
    "sea": "Coastal access and flags remain separate checks.",
    "wildlife": "Respect habitats and other visitors.",
    "advice": "Adapt your route and breaks to your group rather than a calendar guarantee."
  }
];

const L = locale === 'en'
  ? {
      eyebrow: 'Seasonal visit planning',
      heading: 'Weather and coastal conditions: planning questions',
      intro: 'These are conditional planning scenarios, not measured climate averages or current coastal safety reports. Check current official weather and local access instructions.',
      tSeason: 'Season / period',
      tWeather: 'Weather & temperature',
      tSea: 'Sea / water',
      tWildlife: 'Wildlife / nature',
      tAdvice: 'Visit recommendation',
      foot: 'A forecast does not establish swimming safety, monument opening or the condition of a path.'
    }
  : {
      eyebrow: 'कालानुरूप भेटीची योजना',
      heading: 'हवामान आनी किनारी परिस्थितीप्रमाणें नियोजन',
      intro: 'ह्यो शक्य परिस्थितींत नियोजनाच्यो सुचोवण्यो; मापिल्ली हवामान सरासरी वा चालू किनारी सुरक्षिततायेची खबर न्हय. अधिकृत हवामान आनी स्थानिक रसद पळयात.',
      tSeason: 'ऋतू / काळ',
      tWeather: 'हवामान व तापमान',
      tSea: 'समुद्र / पाणी',
      tWildlife: 'वन्यजीव / निसर्ग',
      tAdvice: 'भेटीची शिफारस',
      foot: 'अंदाज पोहपाची सुरक्षितताय, किल्लो उगडो आसा वा वाट सुरक्षित आसा हें निश्चित करीना. चालू अधिकृत सूचना आनी किनारी व्यवस्थापनाच्यो सूचना मानात.'
    };

const rows = locale === 'en' ? rowsEn : rowsKok;
---
<section id="season" class="bg-sea-900 py-20 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <p class="text-sm font-black uppercase tracking-[.18em] text-sea-300">{L.eyebrow}</p>
    <h2 class="mt-3 max-w-3xl text-4xl font-black tracking-tight sm:text-5xl">{L.heading}</h2>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-sea-100/80">{L.intro}</p>

    <div class="season-table-scroll mt-9 max-w-full overflow-x-auto rounded-[2rem] border border-white/15" tabindex="0" role="region" aria-label={L.heading}>
      <table class="w-full border-collapse text-left text-sm">
        <thead class="bg-white/10 text-xs font-black uppercase tracking-[.1em] text-sea-100">
          <tr>
            <th class="p-4">{L.tSeason}</th>
            <th class="p-4">{L.tWeather}</th>
            <th class="p-4">{L.tSea}</th>
            <th class="p-4">{L.tWildlife}</th>
            <th class="p-4">{L.tAdvice}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          {rows.map((r) => (
            <tr class="align-top">
              <td class="p-4"><span class="block font-black text-white">{r.season}</span><span class="text-xs text-sea-200/80">{r.period}</span></td>
              <td class="p-4 leading-6 text-sea-100/80">{r.weather}</td>
              <td class="p-4 leading-6 text-sea-100/80">{r.sea}</td>
              <td class="p-4 leading-6 text-sea-100/80">{r.wildlife}</td>
              <td class="p-4 leading-6 text-sea-100/85">{r.advice}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-5 text-xs leading-6 text-sea-100/60">{L.foot}</p>
  </div>
</section>
