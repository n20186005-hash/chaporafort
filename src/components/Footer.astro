---
import Logo from './Logo.astro';
import { getI18n, navItems, localeBase, type Locale } from '../i18n/ui';
import { COUNTRY_NAME, COUNTRY_NAME_LOCAL } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const base = localeBase(locale);

const gp = locale === 'en' ? 'Anjuna-Caisua Village Panchayat' : 'अंजुना-कायसुवा ग्राम पंचायत';
const country = locale === 'en' ? COUNTRY_NAME : COUNTRY_NAME_LOCAL;
const ui = getI18n(locale, { gp, country });
const nav = navItems(locale);
---
<footer class="border-t border-laterite-900/10 bg-laterite-900 text-sand-100">
  <div class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
    <div class="grid gap-9 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <div class="inline-flex rounded-xl bg-sand-50 p-2"><Logo compact={true} locale={locale} /></div>
        <p class="mt-5 max-w-xl text-sm leading-7 text-sand-100/80">{ui.footerIntro}</p>
      </div>
      <div class="space-y-4 text-sm leading-7 text-sand-100/80">
        <p>{ui.footerInfo}</p>
        <p>{ui.imgRights}<a class="font-bold text-white underline" href={`${base}/terms/#image-rights`}>{ui.termsLink}</a>.</p>
        <p>{ui.copyright}</p>
        <nav aria-label={ui.topicsNav} class="border-t border-sand-100/15 pt-4">
          <p class="text-xs font-black uppercase tracking-[.18em] text-sand-300">{ui.footerTopics}</p>
          <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm font-bold text-white/90">
            {nav.map((n) => (
              <a href={`${base}/#${n.id}`}>{n.label}</a>
            ))}
          </div>
        </nav>
        <div class="flex flex-wrap gap-x-5 gap-y-2 pt-3 font-bold text-white">
          <a href={`${base}/privacy/`}>{ui.footerPrivacy}</a>
          <a href={`${base}/terms/`}>{ui.footerTerms}</a>
          <a href={`${base}/cookies/`}>{ui.footerCookies}</a>
        </div>
      </div>
    </div>
  </div>
</footer>
