---
// प्रकारान छान वावर-मार्ग (व्यक्ती/कुटुंबानुसार) आनी सामान्य अर्ध-दिवस / पूर्ण-दिवस मार्ग.
// सगळे मार्ग किल्ल्याच्या चडणीच्या पायथ्याक पावल्या उपरांत सुरू जातात.
import { type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const personasKok = [
  {
    "title": "कुटुंबाची भेट",
    "icon": "👨‍👩‍👧",
    "points": [
      "खात्रीच्या उगडपाच्या वेळांत ल्हान भेट निवडात.",
      "गटाखातीर चडण आनी जमीन तपासात; भुरग्यांक कड्यांपासून दूर दवरात.",
      "उदक, विसवो आनी परतीची भेट सुवात ठरयात."
    ]
  },
  {
    "title": "फोटो आनी निसर्ग",
    "icon": "📷",
    "points": [
      "उगडपाची वेळ आनी फोटोची परवानगी विचारात; सूर्यास्ताचें दृश्य म्हळ्यार त्या वेळार प्रवेश न्हय.",
      "लेटराइट भिंत, न्हंयमुख आनी किनाऱ्याचीं मेळपी दृश्यां निवडात.",
      "अडथळे मानात आनी झाडां-जनावरांक त्रास दिवं नाकात."
    ]
  },
  {
    "title": "रसद आनी ल्हान भेट",
    "icon": "♿",
    "points": [
      "प्रवासाआदी खरी वाट आनी योग्य रसद व्यवस्थापनाक विचारात.",
      "सगळी वाट पांवड्यांबगर वा वाहन थेट चडणेकडेन पावतलें अशें मानूं नाकात.",
      "वाट आपल्या गरजेक जुळना जाल्यार दुसरो पर्याय निवडात."
    ]
  }
];
const personasEn = [
  {
    "title": "Family visit",
    "icon": "👨‍👩‍👧",
    "points": [
      "Choose a short visit during confirmed opening hours.",
      "Assess the climb and surfaces for your group; keep children away from edges.",
      "Plan water, breaks and a return meeting point."
    ]
  },
  {
    "title": "Photography and nature",
    "icon": "📷",
    "points": [
      "Confirm opening and photography permissions first; sunset views do not establish sunset admission.",
      "Choose accessible views of laterite walls, the river mouth and coastline.",
      "Respect barriers and avoid disturbing plants or animals."
    ]
  },
  {
    "title": "Mobility and shorter visits",
    "icon": "♿",
    "points": [
      "Ask management about the actual approach and suitable access before travelling.",
      "Do not assume a complete step-free route or guaranteed vehicle access to the climb.",
      "Select an alternative when the route does not meet your needs."
    ]
  }
];

const generalKok = [
  {
    "title": "ल्हान भेट",
    "steps": [
      "चालू प्रवेश आनी पावपाची वाट विचारात.",
      "उगड्या भागांतलीं थोडीं ठिकाणां निवडात.",
      "परती आनी विसव्या खातीर वेळ दवरात."
    ]
  },
  {
    "title": "लांब भेट",
    "steps": [
      "परवानगीच्या भागांत वेळ घालात; सगळे भाग उगडे आसतले अशें मानूं नाकात.",
      "रसद आनी प्रवास तपासून वेगळो किनारी पडाव निवडात.",
      "परतीचें नियोजन करात; बंद वेळेउपरांत परत प्रवेश मानूं नाकात."
    ]
  }
];
const generalEn = [
  {
    "title": "Shorter visit",
    "steps": [
      "Confirm the actual entrance and approach.",
      "Choose a small selection of open fort features.",
      "Leave time for the return and breaks."
    ]
  },
  {
    "title": "Longer visit",
    "steps": [
      "Spend more time on permitted fort areas without assuming every section is open.",
      "Consider one separate coastal stop only after checking access and the journey.",
      "Confirm return arrangements; do not plan re-entry after closing."
    ]
  }
];

const L = locale === 'en'
  ? { eyebrow: 'Itineraries', heading: 'Routes by type and general visit plans' }
  : { eyebrow: 'वावर-मार्ग', heading: 'प्रकारान छान मार्ग आनी सामान्य भेटीची योजना' };

const personas = locale === 'en' ? personasEn : personasKok;
const general = locale === 'en' ? generalEn : generalKok;
---
<section id="itinerary" class="bg-sand-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <p class="text-sm font-black uppercase tracking-[.18em] text-sea-700">{L.eyebrow}</p>
    <h2 class="mt-3 max-w-3xl text-4xl font-black tracking-tight text-laterite-900 sm:text-5xl">{L.heading}</h2>

    <div class="mt-9 grid gap-5 lg:grid-cols-3">
      {personas.map((p) => (
        <article class="rounded-3xl border border-laterite-900/10 bg-white p-6 shadow-sm">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sea-500/12 text-2xl" aria-hidden="true">{p.icon}</div>
          <h3 class="mt-4 text-xl font-black text-laterite-900">{p.title}</h3>
          <ol class="mt-4 space-y-2.5 text-sm leading-7 text-laterite-900/75">
            {p.points.map((pt) => <li class="flex gap-2"><span class="font-black text-sea-700">›</span><span>{pt}</span></li>)}
          </ol>
        </article>
      ))}
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      {general.map((g) => (
        <article class="rounded-3xl bg-laterite-900 p-6 text-sand-100 sm:p-7">
          <h3 class="text-xl font-black">{g.title}</h3>
          <ol class="mt-4 space-y-3 text-sm leading-7 text-sand-100/85">
            {g.steps.map((s, i) => (
              <li class="flex gap-3"><span class="shrink-0 rounded-full bg-sand-100/15 px-2.5 py-0.5 text-xs font-black text-sand-100">{i + 1}</span><span>{s}</span></li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </div>
</section>
