---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSiteName } from '../data/site';
import { getI18n, type Locale } from '../i18n/ui';

const isEn = Astro.url.pathname.startsWith('/en/');
const locale: Locale = isEn ? 'en' : 'kok';
const ui = getI18n(locale);
---
<BaseLayout title={withSiteName(ui.nfTitle, locale)} description={ui.nfDesc} locale={locale} noindex={true}>
  <section class="bg-sand-50 py-24">
    <div class="mx-auto max-w-3xl px-5 text-center lg:px-8">
      <p class="text-sm font-black uppercase tracking-[.18em] text-laterite-500">404</p>
      <h1 class="mt-3 text-4xl font-black text-laterite-900 sm:text-5xl">{ui.nfH1}</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-8 text-laterite-900/70">{ui.nfP}</p>
      <a href={locale === 'en' ? '/en/' : '/'} class="mt-8 inline-flex rounded-full bg-sea-900 px-5 py-3 font-black text-white no-underline">{ui.backHome}</a>
    </div>
  </section>
</BaseLayout>
