---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="पान मेळ्ळें ना | चापोरा किल्ला प्रवासी मार्गदर्शक" description="मागिल्लें पान मेळ्ळें ना." noindex={true}>
  <section class="bg-sand-50 py-24">
    <div class="mx-auto max-w-3xl px-5 text-center lg:px-8">
      <p class="text-sm font-black uppercase tracking-[.18em] text-laterite-500">404</p>
      <h1 class="mt-3 text-4xl font-black text-laterite-900 sm:text-5xl">हें पान मेळ्ळें ना</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-8 text-laterite-900/70">मुखेल प्रवासी मार्गदर्शकाक परत वचून किल्ल्याची माहिती, नकाशो आनी भेट नियोजन पळयात.</p>
      <a href="/" class="mt-8 inline-flex rounded-full bg-sea-900 px-5 py-3 font-black text-white no-underline">मुखेल पानार वचात</a>
    </div>
  </section>
</BaseLayout>
