---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSiteName } from '../data/site';
import { type Locale } from '../i18n/utils';

const isEn = Astro.url.pathname.startsWith('/en/');
const locale: Locale = isEn ? 'en' : 'kok';
const L = locale === 'en'
  ? { title: 'Page not found', desc: 'The requested page was not found.', h1: 'This page was not found', p: 'Go back to the main tourist guide to see the fort info, map and visit planning.', btn: 'Back to home' }
  : { title: 'पान मेळ्ळें ना', desc: 'मागिल्लें पान मेळ्ळें ना.', h1: 'हें पान मेळ्ळें ना', p: 'मुखेल प्रवासी मार्गदर्शकाक परत वचून किल्ल्याची माहिती, नकाशो आनी भेट नियोजन पळयात.', btn: 'मुखेल पानार वचात' };
---
<BaseLayout title={withSiteName(L.title, locale)} description={L.desc} locale={locale} noindex={true}>
  <section class="bg-sand-50 py-24">
    <div class="mx-auto max-w-3xl px-5 text-center lg:px-8">
      <p class="text-sm font-black uppercase tracking-[.18em] text-laterite-500">404</p>
      <h1 class="mt-3 text-4xl font-black text-laterite-900 sm:text-5xl">{L.h1}</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-8 text-laterite-900/70">{L.p}</p>
      <a href={locale === 'en' ? '/en/' : '/'} class="mt-8 inline-flex rounded-full bg-sea-900 px-5 py-3 font-black text-white no-underline">{L.btn}</a>
    </div>
  </section>
</BaseLayout>
