---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from '../components/WeatherSection.astro';
import FacilitiesSection from '../components/FacilitiesSection.astro';
import StoriesSection from '../components/StoriesSection.astro';

const siteUrl = Astro.site ? new URL('/', Astro.site).href : undefined;
const heroUrl = Astro.site ? new URL('/images/chapora-fort-hero.jpg', Astro.site).href : undefined;
const logoUrl = Astro.site ? new URL('/logo.svg', Astro.site).href : undefined;
const pageTitle = 'चापोरा किल्ला | वागातोर, उत्तर गोवा प्रवासी मार्गदर्शक';
const pageDesc = 'चापोरा किल्ल्याचो इतिहास, वेळा, खर्च, पार्किंग, प्रवास, वागातोर-अंजुना भोंवतणीची ठिकाणां, स्थानिक जेवण आनी भेटीचें नियोजन.';

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': siteUrl ? `${siteUrl}#chapora-fort` : '#chapora-fort',
  name: 'Chapora Fort',
  alternateName: ['चापोरा किल्ला', 'चपोरा फोर्ट'],
  description: 'बार्देश तालुक्यात, वागातोर जवळच्या डोंगरमाथ्यावर असलेला चापोरा किल्ला हा लाल लेटराइट दगडाचा ऐतिहासिक किल्ला असून चापोरा नदी, अरबी समुद्र आणि किनाऱ्यांची विस्तीर्ण दृश्ये देतो.',
  ...(siteUrl ? { url: siteUrl } : {}),
  ...(heroUrl ? { image: [heroUrl] } : {}),
  telephone: '+91 832 249 4500',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Chapora Fort Trail, Vagator, Anjuna, Chapora',
    addressLocality: 'Chapora',
    addressRegion: 'Goa',
    postalCode: '403509',
    addressCountry: 'IN'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 15.604637485009572,
    longitude: 73.73438817702883
  },
  containedInPlace: {
    '@type': 'AdministrativeArea',
    name: 'Village Panchayat Anjuna-Caisua, Bardez, North Goa'
  },
  hasMap: 'https://maps.app.goo.gl/3z6axsvdHe2spoFg8',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 4.2,
    reviewCount: 27105,
    bestRating: 5,
    worstRating: 1
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '10:00',
    closes: '17:00'
  }],
  sameAs: [
    'https://www.goa.gov.in/places/chapora-fort/',
    'https://goa-tourism.com/fort/chapora-fort/',
    'https://maps.app.goo.gl/3z6axsvdHe2spoFg8'
  ]
};

const faqs = [
  ['चापोरा किल्ल्याक भेट दिवपाची बरी वेळ खंयची?', 'गोवा पर्यटनाच्या माहितीनुसार सांजवेळ बरी, कारण दनपाराचो उश्णपण कमी जाता आनी अरबी समुद्राचो सूर्यास्त पळोवपाक मेळटा. पावसाळ्यात वाट ओली आनी निसरडी आसूंक शकता.'],
  ['किल्लो पळोवपाक कितलो वेळ राखचो?', 'किल्ल्याच्या भिंती, दृश्यबिंदू आनी चडण धरून साधारण १ ते २ वरां राखप उपेगी. फोटो वा सूर्यास्त खातीर जास्त वेळ राखूंक शकतात.'],
  ['प्रवेश तिकीट आसा काय?', 'गोवा सरकार आनी गोवा पर्यटनाच्या चापोरा किल्ला पानांवर स्वतंत्र प्रवेश तिकीट दर नमूद ना. पार्किंग, वाहन वा इतर सेवांचे शुल्क वेगळें आसूंक शकता; निघचे आदी ताजी अधिकृत माहिती तपासात.'],
  ['पार्किंग मेळटा काय?', 'किल्ल्याक चडपी वाटेच्या पायथ्याक वाहन उबोवपाची व्यवस्था मेळटा, पूण जागा मर्यादित आसूंक शकता. हंगाम, गर्दी आनी स्थानिक व्यवस्थापनाप्रमाणें शुल्क बदलूंक शकता.'],
  ['वागातोर थावन किल्ल्याक कशें पावचें?', 'वागातोर भागातून रस्त्यान पायथ्याक पावून शेवटचो भाग पायी चडचो पडटा. मापुसा थावन अंजुना-वागातोर मार्गान बस सेवा मेळटा, अशी गोवा पर्यटनाची माहिती आसा.'],
  ['ल्हान भुरग्यां वा चालपाक त्रास आशिल्ल्यां खातीर सोपें आसा काय?', 'शेवटची चडण उंच, उन्हातली आनी काही ठिकाणी असमान आसा. आरामदायी पादत्राणां, उदक आनी मधेमधे विसोवो घेवप उपेगी. व्हीलचेअर प्रवेश मर्यादित आसा.'],
  ['किल्ल्याचेर शौचालय, उदक वा विसोव घेवपाची सोय आसा काय?', 'किल्ल्याच्या आतल्या प्रदेशांत सार्वजनिक शौचालय आनी पिवपाच्या उदकाची निश्चित सोय ना. वागातोर किनाऱ्याकडलो रस्तो, चापोरा गांव वा किनारपट्टीचेर कांय सोयी आसूंक शकतात. निघतना पिवपाचें उदक आनी जरुरीच्यो वस्तू सोबत दवरात.'],
  ['जेवण, रावप, दुकानां, इंधन कशीं मेळटात?', 'भोंवतणच्या सोयींचो वर्गवारीन सविस्तर उल्लेख वयल्या ‘सुविधा’ भागांत दिला आसा – जेवण/उपाहार, गेस्टहाउस/हॉमस्टे/रिसॉर्ट, गांवांतलीं दुकानां, इंधन केंद्रां आनी विद्युत वाहन चार्जिंग. हें नाफायद्याचें मार्गदर्शक कोणाचोय खाजगी उपक्रम शिफारस करिना; अचूक जागा भेटेच्या वेळार नकाशांत पळयात.']
];
const faqSchema = {
  '@context':'https://schema.org', '@type':'FAQPage',
  mainEntity: faqs.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } }))
};

// E-E-A-T：项目主体 + 站点 + 页面（dateModified 固定为内容更新时间，避免构建漂移）
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': siteUrl ? `${siteUrl}#organization` : '#organization',
  name: 'चापोरा किल्ला प्रवासी मार्गदर्शक',
  description: 'चापोरा किल्ल्याचो स्वतंत्र, नाफायद्याचो प्रवासी माहिती मार्गदर्शक प्रकल्प.',
  ...(siteUrl ? { url: siteUrl } : {}),
  ...(logoUrl ? { logo: logoUrl } : {})
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': siteUrl ? `${siteUrl}#website` : '#website',
  ...(siteUrl ? { url: siteUrl } : {}),
  name: 'चापोरा किल्ला प्रवासी मार्गदर्शक',
  inLanguage: 'kok-Deva',
  publisher: { '@id': siteUrl ? `${siteUrl}#organization` : '#organization' }
};
const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': siteUrl ? `${siteUrl}#webpage` : '#webpage',
  ...(siteUrl ? { url: siteUrl } : {}),
  name: pageTitle,
  description: pageDesc,
  inLanguage: 'kok-Deva',
  datePublished: '2026-09-03',
  dateModified: '2026-09-03',
  isPartOf: { '@id': siteUrl ? `${siteUrl}#website` : '#website' },
  about: { '@id': siteUrl ? `${siteUrl}#chapora-fort` : '#chapora-fort' },
  ...(heroUrl ? { primaryImageOfPage: { '@type': 'ImageObject', url: heroUrl } } : {})
};
---
<BaseLayout
  title={pageTitle}
  description={pageDesc}
  jsonLd={[organizationSchema, websiteSchema, webpageSchema, attractionSchema, faqSchema]}
>
  <section class="relative isolate overflow-hidden bg-laterite-900 text-white">
    <div class="absolute inset-0">
      <div class="photo-frame h-full w-full">
        <div class="photo-fallback"><span class="max-w-md text-sm opacity-80">चापोरा किल्ल्याचें स्थानिक छायाचित्र</span></div>
        <img src="/images/chapora-fort-hero.jpg" alt="चापोरा किल्ल्याची लाल लेटराइट भिंत आनी अरबी समुद्र" width="1600" height="900" onerror="this.style.display='none'" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-laterite-900/95 via-laterite-900/72 to-sea-900/25"></div>
      <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-laterite-900 to-transparent"></div>
    </div>
    <div class="relative mx-auto grid min-h-[75vh] max-w-7xl items-end gap-8 px-5 pb-16 pt-28 lg:grid-cols-[1.1fr_.6fr] lg:px-8 lg:pb-24">
      <div>
        <p class="mb-5 inline-flex rounded-full border border-white/25 bg-white/10 px-4 py-2 text-sm font-bold backdrop-blur">वागातोर · बार्देश · उत्तर गोवा</p>
        <h1 class="max-w-4xl text-5xl font-black leading-[1.05] tracking-tight sm:text-7xl">चापोरा किल्ला</h1>
        <p class="mt-5 max-w-2xl text-xl leading-9 text-sand-100/92">चापोरा नदी, अरबी समुद्र आनी वागातोरच्या किनाऱ्याक वयरसून पळयपी, लाल लेटराइट दगडाच्या तटबंदींत इतिहास आनी समुद्री क्षितिज एकठांय येता.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#भेट" class="rounded-full bg-sand-100 px-5 py-3 font-extrabold text-laterite-900 no-underline">भेट नियोजन</a>
          <a href="#नकाशो" class="rounded-full border border-white/35 bg-white/10 px-5 py-3 font-extrabold text-white no-underline backdrop-blur">नकाशो पळयात</a>
        </div>
      </div>
      <div class="rounded-3xl border border-white/20 bg-black/25 p-6 backdrop-blur-md">
        <div class="flex items-end justify-between gap-4"><div><div class="text-sm text-sand-100/75">गुगल नकाशा गुणांकन</div><div class="mt-1 text-3xl font-black">4.2 <span class="text-lg">/ 5</span></div></div><div class="text-right text-sm text-sand-100/75">27,105 अभिप्राय</div></div>
        <dl class="mt-6 grid gap-4 border-t border-white/15 pt-5 text-sm">
          <div><dt class="text-sand-100/65">पत्तो</dt><dd class="mt-1 font-bold">चापोरा फोर्ट ट्रेल, वागातोर, अंजुना, चापोरा, गोवा 403509</dd></div>
          <div><dt class="text-sand-100/65">दूरध्वनी</dt><dd class="mt-1 font-bold"><a href="tel:+918322494500">+91 832 249 4500</a></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="rampart-edge -mt-1 h-10 bg-laterite-500" aria-hidden="true"></section>

  <section id="इतिहास" class="fort-grid bg-sand-50 py-20 lg:py-28">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[.85fr_1.15fr] lg:px-8">
      <div>
        <p class="text-sm font-black uppercase tracking-[.18em] text-laterite-500">किल्ल्याची ओळख</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-laterite-900 sm:text-5xl">तटबंदी जी डोंगराच्या आकाराक धरून वळटा</h2>
      </div>
      <div class="space-y-5 text-lg leading-9 text-laterite-900/80">
        <p>चापोरा किल्लो बार्देश तालुक्यांत, चापोरा नदीच्या मुखाक लागून उंच डोंगरमाथ्यार आसा. गोवा पर्यटन विकास महामंडळ ताका प्राचीन लेटराइट किल्लो म्हणटा; भिंती नैसर्गिक उतारांबरोबर वळतात, अनियमित बुरुज आनी तोफां खातीर खोल जागा दिसतात.</p>
        <p>पोर्तुगीजांनी आदिलशाही काळांतल्या आधीच्या लष्करी ठाण्याच्या अवशेषांवर किल्ल्याचो वापर केला. 1684 आनी 1739 ह्या काळांत मराठ्यांनी ताबो घेतला; 1717 त पोर्तुगीजांनी पुनर्बांधणी करून भूमिगत मार्ग जोडले. उत्तर सीमा पुढें सरकल्यान किल्ल्याचें लष्करी महत्त्व कमी जालें आनी 1892 त तो सोडून दिलो.</p>
        <p>आज आतील बराकां वा इमारती फारशा उरल्या नात; मुख्य अनुभव म्हणजें तटबंदी, उघडें पठार, चापोरा नदीचें मुख, वागातोर-अंजुना किनारे आनी अरबी समुद्राचो सूर्यास्त.</p>
        <div class="mt-8 rounded-3xl border border-laterite-900/10 bg-white p-6 shadow-sm">
          <h3 class="text-base font-black uppercase tracking-[.14em] text-laterite-500">मुखेल काळ-ओळ</h3>
          <ul class="mt-4 space-y-3 text-sm leading-6">
            <li class="flex gap-4"><span class="w-20 shrink-0 font-black text-sea-700">आदिलशाही</span><span class="text-laterite-900/75">आदिलशाही राजवटींत ‘शाहापुरा’ नांवाचें सुरक्षा ठाणें; उपरांत पुर्तुगेजांनी बार्देश घेतल्यान किल्ल्याचो वापर केलो.</span></li>
            <li class="flex gap-4"><span class="w-20 shrink-0 font-black text-laterite-500">1684 / 1739</span><span class="text-laterite-900/75">गोवा पर्यटनाच्या नोंदीप्रमाणें ह्या दोन काळांत मराठ्यांनी किल्ल्याचेर ताबो घेतलो.</span></li>
            <li class="flex gap-4"><span class="w-20 shrink-0 font-black text-sea-700">1717</span><span class="text-laterite-900/75">पुर्तुगेजांनी परत घेवन पुनर्बांधणी केली – बुरुज, तोफां खातीर जागा आनी न्हंयेक वचपी आपत्कालीन वाट.</span></li>
            <li class="flex gap-4"><span class="w-20 shrink-0 font-black text-laterite-500">1741</span><span class="text-laterite-900/75">‘नव्या जैतां’ उपरांत परत जिंकलो; सीमा उत्तरेकडे सरकल्यान लश्करी महत्त्व उणें जालें.</span></li>
            <li class="flex gap-4"><span class="w-20 shrink-0 font-black text-sea-700">1892</span><span class="text-laterite-900/75">सैनिकी दृष्टीन किल्लो सोडून दिलो; आयज हो वारसा पर्यटकां खातीर उगडो आसा.</span></li>
            <li class="flex gap-4"><span class="w-20 shrink-0 font-black text-laterite-500">2001</span><span class="text-laterite-900/75">‘दिल चाहता है’ चित्रपटांतलीं दृश्यां हांगा चित्रित जाल्लीं – किल्लो नव्या पिढयेक परिचित जालो.</span></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="mx-auto mt-14 grid max-w-7xl gap-5 px-5 md:grid-cols-3 lg:px-8">
      <figure class="photo-frame aspect-[4/5] rounded-[2rem]"><div class="photo-fallback">तटबंदीचें छायाचित्र</div><img loading="lazy" src="/images/chapora-fort-walls.jpg" alt="चापोरा किल्ल्याची लेटराइट तटबंदी" width="900" height="1125" onerror="this.style.display='none'" /></figure>
      <figure class="photo-frame aspect-[4/5] rounded-[2rem] md:translate-y-8"><div class="photo-fallback">किल्ल्याच्या आतील भागाचें छायाचित्र</div><img loading="lazy" src="/images/chapora-fort-interior.jpg" alt="चापोरा किल्ल्याच्या आतील मोकळ्या भागांतली तटबंदी" width="900" height="1125" onerror="this.style.display='none'" /></figure>
      <figure class="photo-frame aspect-[4/5] rounded-[2rem]"><div class="photo-fallback">समुद्री दृश्याचें छायाचित्र</div><img loading="lazy" src="/images/chapora-fort-sea-view.jpg" alt="चापोरा किल्ल्यावयल्यान दिसपी अरबी समुद्र आनी किनारो" width="900" height="1125" onerror="this.style.display='none'" /></figure>
    </div>
  </section>

  <section id="भेट" class="bg-sea-900 py-20 text-white lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <p class="text-sm font-black uppercase tracking-[.18em] text-sea-300">भेट नियोजन</p>
      <h2 class="mt-3 max-w-3xl text-4xl font-black tracking-tight sm:text-5xl">चडण, उन आनी सूर्यास्त ध्यानांत दवरून वेळ आखात</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-3xl bg-white/8 p-6 ring-1 ring-white/12"><div class="text-3xl">◷</div><h3 class="mt-5 text-xl font-black">उगडपाची वेळ</h3><p class="mt-2 leading-7 text-sea-100/80">गुगल नकाशांत 10:00–17:00 अशी वेळ दिसता. सुट्टी, देखभाल वा स्थानिक बदलांमुळे वेळा बदलूंक शकतात; भेटी आदी तपासात.</p></article>
        <article class="rounded-3xl bg-white/8 p-6 ring-1 ring-white/12"><div class="text-3xl">₹</div><h3 class="mt-5 text-xl font-black">तिकीट / खर्च</h3><p class="mt-2 leading-7 text-sea-100/80">गोवा सरकार आनी गोवा पर्यटनाच्या किल्ला पानांवर स्वतंत्र प्रवेश दर नमूद ना. वाहन, पार्किंग वा इतर सेवांचे शुल्क वेगळें आसूंक शकता.</p></article>
        <article class="rounded-3xl bg-white/8 p-6 ring-1 ring-white/12"><div class="text-3xl">P</div><h3 class="mt-5 text-xl font-black">पार्किंग</h3><p class="mt-2 leading-7 text-sea-100/80">चडपी वाटेच्या पायथ्याक पार्किंग मेळटा, पूण गर्दीच्या वेळार जागा मर्यादित आसूंक शकता. मौसमी शुल्क आसल्यार तें जाग्यार तपासात.</p></article>
        <article class="rounded-3xl bg-white/8 p-6 ring-1 ring-white/12"><div class="text-3xl">☀</div><h3 class="mt-5 text-xl font-black">बरी वेळ / कितलो वेळ</h3><p class="mt-2 leading-7 text-sea-100/80">सांजवेळ उश्णपण कमी आनी सूर्यास्ताक योग्य. साधारण 1–2 वरां राखात; चडण खातीर उदक, टोपी आनी घट्ट पादत्राणां घेवात.</p></article>
