---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="कुकी मांडावळ | चापोरा किल्ला प्रवासी मार्गदर्शक" description="कुकी पसंती बदलपाचें स्वतंत्र पान.">
  <section class="bg-sand-50 py-16 lg:py-24"><article class="prose-legal mx-auto max-w-3xl px-5 lg:px-8"><p class="text-sm font-black text-laterite-500">शेवटचें अद्ययावत: सप्टेंबर 2026</p><h1 class="mt-3 text-4xl font-black text-laterite-900 sm:text-5xl">कुकी मांडावळ</h1><p class="mt-6 text-lg">तुमी हांगा कुकी आनी ब्राउझर साठवणीची पसंती थेट बदलूंक शकतात. आवश्यक साठवण संकेतथळाच्या मूलभूत कामा खातीर वापरली जावंक शकता; विश्लेषण फकत तुमच्या परवानगीन चालू जाता.</p>
  <form id="cookie-form" class="mt-9 space-y-4" aria-describedby="save-status">
    <label class="flex items-start justify-between gap-5 rounded-3xl border border-laterite-900/10 bg-white p-5"><span><strong class="block text-lg">आवश्यक कुकी</strong><span class="mt-1 block text-sm text-laterite-900/65">संकेतथळाची मूलभूत मांडावळ चालू दवरपाक गरजेची. बंद करूं येना.</span></span><input class="mt-2 h-5 w-5" type="checkbox" checked disabled /></label>
    <label class="flex items-start justify-between gap-5 rounded-3xl border border-laterite-900/10 bg-white p-5"><span><strong class="block text-lg">विश्लेषण कुकी</strong><span class="mt-1 block text-sm text-laterite-900/65">गुगल अॅनालिटिक्स मार्फत एकत्रित वापर समजून घेवपाक. सुरू केल्याबगर लोड जावना.</span></span><input id="analytics" class="mt-2 h-5 w-5" type="checkbox" /></label>
    <label class="flex items-start justify-between gap-5 rounded-3xl border border-laterite-900/10 bg-white p-5"><span><strong class="block text-lg">पसंती साठवण</strong><span class="mt-1 block text-sm text-laterite-900/65">तुमच्या कुकी मांडावळी सारख्या पसंती ह्या ब्राउझरांत लक्षांत दवरता.</span></span><input id="preferences" class="mt-2 h-5 w-5" type="checkbox" /></label>
    <label class="flex items-start justify-between gap-5 rounded-3xl border border-laterite-900/10 bg-white p-5"><span><strong class="block text-lg">विपणन कुकी</strong><span class="mt-1 block text-sm text-laterite-900/65">ह्या प्रकल्पांत जाहिरात वा वैयक्तिकीकृत विपणन स्क्रिप्ट लोड केल्या जात नात. मांडावळ बंदच दवरली आसा.</span></span><input class="mt-2 h-5 w-5" type="checkbox" disabled /></label>
    <div class="flex flex-wrap gap-3 pt-3"><button class="rounded-full bg-sea-900 px-5 py-3 font-black text-white" type="submit">पसंती जतन करात</button><button id="reject" class="rounded-full border border-laterite-900/20 bg-white px-5 py-3 font-black text-laterite-900" type="button">आवश्यक सोडून सगळें नाकारात</button></div>
    <p id="save-status" class="min-h-6 text-sm font-bold text-sea-700" aria-live="polite"></p>
  </form>
  <h2>संमती बदलप</h2><p>ह्या पानार परत येऊन तुमी केन्नाय मांडावळ बदलूंक शकतात. विश्लेषण बंद केल्या उपरांत पुढची पान भेट गुगल अॅनालिटिक्स लोड करची ना; आधीच तयार जाल्ले तिसऱ्या पक्षाचे कुकी तुमच्या ब्राउझर मांडावळींतून मिटोवचे लागूंक शकतात.</p></article></section>
  <script is:inline>
    (() => {
      const KEY = 'chapora-consent-v1';
      const form = document.getElementById('cookie-form');
      const analytics = document.getElementById('analytics');
      const preferences = document.getElementById('preferences');
      const reject = document.getElementById('reject');
      const status = document.getElementById('save-status');
      let saved = null;
      try { saved = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch {}
      if (saved) { analytics.checked = !!saved.analytics; preferences.checked = !!saved.preferences; }
      const store = (data) => { localStorage.setItem(KEY, JSON.stringify(data)); status.textContent = 'तुमची पसंती ह्या ब्राउझरांत जतन जाली.'; };
      form.addEventListener('submit', (e) => { e.preventDefault(); store({ necessary:true, analytics:analytics.checked, preferences:preferences.checked, marketing:false }); if (analytics.checked) location.reload(); });
      reject.addEventListener('click', () => { analytics.checked = false; preferences.checked = false; store({ necessary:true, analytics:false, preferences:false, marketing:false }); });
    })();
  </script>
</BaseLayout>
