---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_NAME_EN, ATTRACTION_FULL_NAME, ATTRACTION_FULL_NAME_LOCAL, CITY_NAME, CITY_NAME_LOCAL, STATE_PROVINCE, COUNTRY_NAME } from '../data/site';
import { type Locale, otherLocale, hreflangFor } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  image?: string;
  imageAlt?: string;
  jsonLd?: unknown | unknown[];
  noindex?: boolean;
}

const { title, description, locale, image = '/images/chapora-fort-hero.jpg', imageAlt, jsonLd, noindex = false } = Astro.props;
const absolutePageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const absoluteImageUrl = Astro.site ? new URL(image, Astro.site).href : undefined;
const ogImageAlt = imageAlt ?? (locale === 'en'
  ? `${ATTRACTION_FULL_NAME} – ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}`
  : `${ATTRACTION_FULL_NAME} (${ATTRACTION_FULL_NAME_LOCAL}) – ${CITY_NAME_LOCAL}, ${STATE_PROVINCE}, ${COUNTRY_NAME}`);
const ldItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const htmlLang = locale === 'en' ? 'en' : 'kok-Deva';
const altLocale = otherLocale(locale);
const altLocaleUrl = Astro.site ? new URL(locale === 'en' ? '/' : '/en/', Astro.site).href : locale === 'en' ? '/' : '/en/';
const defaultLocaleUrl = Astro.site ? new URL('/', Astro.site).href : '/';
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#71361f" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <title>{title}</title>
    {absolutePageUrl && <link rel="canonical" href={absolutePageUrl} />}
    {absolutePageUrl && <link rel="alternate" hreflang={hreflangFor(altLocale)} href={altLocaleUrl} />}
    <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'kok_IN'} />
    <meta property="og:site_name" content={locale === 'en' ? SITE_NAME_EN : SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {absolutePageUrl && <meta property="og:url" content={absolutePageUrl} />}
    {absoluteImageUrl && <meta property="og:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {absoluteImageUrl && <meta name="twitter:image" content={absoluteImageUrl} />}
    {ldItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)}></script>)}
    <script is:inline>
      (() => {
        const KEY = 'chapora-consent-v1';
        let consent = null;
        try { consent = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch {}
        if (!consent?.analytics || window.__chaporaGAStarted) return;
        window.__chaporaGAStarted = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){ window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'G-HXM22WWPKP', { anonymize_ip: true });
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP';
        document.head.appendChild(s);
      })();
    </script>
  </head>
  <body>
    <Header locale={locale} />
    <main><slot /></main>
    <Footer locale={locale} />
    <script is:inline>
      (() => {
        if (!('serviceWorker' in navigator)) return;
        const host = location.hostname;
        const isDevHost = host === 'loc' + 'alhost' || host === '127.0.0.1' || host.endsWith('.loc' + 'alhost');
        if (isDevHost) return;
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      })();
    </script>
  </body>
</html>
